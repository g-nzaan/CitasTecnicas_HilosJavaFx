<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tecnoasistencia.controlador.MenuController"
            style="-fx-background-color: #f8fafc; -fx-font-family: 'Segoe UI';">

    <!-- Encabezado Superior -->
    <top>
        <VBox spacing="4.0" style="-fx-background-color: #0f172a;">
            <padding>
                <Insets top="16.0" right="24.0" bottom="16.0" left="24.0"/>
            </padding>
            <children>
                <Label text="TecnoAsistencia Nicaragua S.A."
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 12.0; -fx-font-weight: bold;"/>
                <Label text="Sistema de Gestión de Citas de Atención Técnica"
                       style="-fx-text-fill: white; -fx-font-size: 22.0; -fx-font-weight: bold;"/>
                <Label text="Menú Principal de Navegación"
                       style="-fx-text-fill: #cbd5e1; -fx-font-size: 13.0;"/>
            </children>
        </VBox>
    </top>

    <!-- Contenido Central: Tarjetas de Selección de Módulo -->
    <center>
        <VBox alignment="CENTER" spacing="28.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="30.0" right="40.0" bottom="30.0" left="40.0"/>
            </padding>
            <children>
                <VBox alignment="CENTER" spacing="6.0">
                    <children>
                        <Label text="Bienvenido al Sistema de Gestión"
                               style="-fx-font-size: 24.0; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                        <Label text="Seleccione a continuación el módulo al que desea acceder:"
                               style="-fx-font-size: 14.0; -fx-text-fill: #64748b;"/>
                    </children>
                </VBox>

                <!-- Contenedor de las dos tarjetas de módulos -->
                <HBox alignment="CENTER" spacing="35.0">
                    <children>
                        <!-- Tarjeta Módulo de Clientes -->
                        <VBox prefWidth="400.0" spacing="16.0"
                              style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 12.0; -fx-background-radius: 12.0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 16, 0, 0, 4);">
                            <padding>
                                <Insets top="28.0" right="28.0" bottom="28.0" left="28.0"/>
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="DIRECTORIO &amp; CONTACTOS"
                                               style="-fx-background-color: #dbeafe; -fx-text-fill: #1d4ed8; -fx-font-size: 11.0; -fx-font-weight: bold; -fx-padding: 4 10 4 10; -fx-background-radius: 12.0;"/>
                                    </children>
                                </HBox>

                                <Label text="Módulo de Clientes"
                                       style="-fx-font-size: 20.0; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                                <Label text="Administración integral de clientes: registro, edición, control de estado activo/inactivo, validaciones de teléfono y correo."
                                       wrapText="true"
                                       style="-fx-text-fill: #64748b; -fx-font-size: 13.0; -fx-line-spacing: 2.0;"/>

                                <Separator/>

                                <VBox spacing="8.0">
                                    <children>
                                        <Label text="✓  Registro y actualización de datos de contacto"
                                               style="-fx-text-fill: #334155; -fx-font-size: 12.0;"/>
                                        <Label text="✓  Búsqueda dinámica en tiempo real"
                                               style="-fx-text-fill: #334155; -fx-font-size: 12.0;"/>
                                        <Label text="✓  Control de estado del cliente (Activo / Inactivo)"
                                               style="-fx-text-fill: #334155; -fx-font-size: 12.0;"/>
                                        <Label text="✓  Carga asíncrona mediante hilos JavaFX"
                                               style="-fx-text-fill: #2563eb; -fx-font-size: 12.0; -fx-font-weight: bold;"/>
                                    </children>
                                </VBox>

                                <Button fx:id="btnAccederClientes" text="Acceder a Clientes →"
                                        maxWidth="Infinity" prefHeight="42.0"
                                        onAction="#handleAccederClientes"
                                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13.0; -fx-background-radius: 8.0; -fx-cursor: hand;"/>
                            </children>
                        </VBox>

                        <!-- Tarjeta Módulo de Citas Técnicas -->
                        <VBox prefWidth="400.0" spacing="16.0"
                              style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 12.0; -fx-background-radius: 12.0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 16, 0, 0, 4);">
                            <padding>
                                <Insets top="28.0" right="28.0" bottom="28.0" left="28.0"/>
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="AGENDA &amp; SERVICIOS"
                                               style="-fx-background-color: #e0f2fe; -fx-text-fill: #0369a1; -fx-font-size: 11.0; -fx-font-weight: bold; -fx-padding: 4 10 4 10; -fx-background-radius: 12.0;"/>
                                    </children>
                                </HBox>

                                <Label text="Módulo de Citas Técnicas"
                                       style="-fx-font-size: 20.0; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                                <Label text="Programación y gestión de citas: asignación de servicios técnicos, verificación de colisiones de horario y filtros por estado."
                                       wrapText="true"
                                       style="-fx-text-fill: #64748b; -fx-font-size: 13.0; -fx-line-spacing: 2.0;"/>

                                <Separator/>

                                <VBox spacing="8.0">
                                    <children>
                                        <Label text="✓  Programación de atención técnica por cliente"
                                               style="-fx-text-fill: #334155; -fx-font-size: 12.0;"/>
                                        <Label text="✓  Prevención de colisión de horarios"
                                               style="-fx-text-fill: #334155; -fx-font-size: 12.0;"/>
                                        <Label text="✓  Filtros dinámicos por estado y fecha"
                                               style="-fx-text-fill: #334155; -fx-font-size: 12.0;"/>
                                        <Label text="✓  Consultas multi-hilo en segundo plano"
                                               style="-fx-text-fill: #0284c7; -fx-font-size: 12.0; -fx-font-weight: bold;"/>
                                    </children>
                                </VBox>

                                <Button fx:id="btnAccederCitas" text="Acceder a Citas Técnicas →"
                                        maxWidth="Infinity" prefHeight="42.0"
                                        onAction="#handleAccederCitas"
                                        style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13.0; -fx-background-radius: 8.0; -fx-cursor: hand;"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>

    <!-- Pie de Página -->
    <bottom>
        <HBox alignment="CENTER" spacing="10.0"
              style="-fx-background-color: #f1f5f9; -fx-border-color: #e2e8f0; -fx-border-width: 1.0 0 0 0;">
            <padding>
                <Insets top="12.0" right="24.0" bottom="12.0" left="24.0"/>
            </padding>
            <children>
                <Label text="TecnoAsistencia Nicaragua S.A.  •  Universidad Americana (UAM)  •  Programación de Aplicaciones de Escritorio"
                       style="-fx-text-fill: #64748b; -fx-font-size: 11.5;"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
